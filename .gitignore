# runs, logs
runs/
*.log

# local checkpoints are ignored, but curated ones under checkpoints/ are kept
*.pt
*.ckpt
!checkpoints/**/*.pt
!checkpoints/**/*.json

# datasets (large / redistribution-restricted)
data/*
!data/.gitkeep

# the paper PDF is not redistributed here
*.pdf

# python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# os / editor
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
